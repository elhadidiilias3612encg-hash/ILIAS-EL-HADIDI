        "\n",
        "# 4. Faire des prédictions sur X_test\n",
        "y_pred_lr = linear_model.predict(X_test)\n",
        "\n",
        "# 6. Calculer le RMSE et le R²\n",
        "rmse_lr = np.sqrt(mean_squared_error(y_reg_test, y_pred_lr))\n",
        "r2_lr = r2_score(y_reg_test, y_pred_lr)\n",
        "\n",
        "print(f\"Régression Linéaire - RMSE: {rmse_lr:.2f}\")\n",
        "print(f\"Régression Linéaire - R²: {r2_lr:.2f}\")\n",
        "\n",
